# העתיקי את הקובץ הזה לקובץ בשם .env והכניסי את המפתח שלך.
# הקובץ .env לא עולה ל-GitHub (הוא ב-.gitignore).

# Gemini (חינמי): https://aistudio.google.com/apikey
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# כדי לעבוד עם OpenAI במקום: מוחקים את LLM_BASE_URL ומשנים את המודל ל-gpt-4o-mini
